<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Edit coefficient1, coefficient2, coefficient3, and threshold for each pressure sensor."
            android:textSize="14sp" />

        <TextView
            style="@style/PressureCalibrationSensorLabel"
            android:text="Toe inside" />

        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_toe_inside_c1"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient1" />
            <EditText
                android:id="@+id/input_toe_inside_c2"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient2" />
        </LinearLayout>
        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_toe_inside_c3"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient3" />
            <EditText
                android:id="@+id/input_toe_inside_threshold"
                style="@style/PressureCalibrationInput"
                android:hint="threshold (mV)" />
        </LinearLayout>

        <TextView
            style="@style/PressureCalibrationSensorLabel"
            android:text="Mid inside" />

        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_mid_inside_c1"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient1" />
            <EditText
                android:id="@+id/input_mid_inside_c2"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient2" />
        </LinearLayout>
        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_mid_inside_c3"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient3" />
            <EditText
                android:id="@+id/input_mid_inside_threshold"
                style="@style/PressureCalibrationInput"
                android:hint="threshold (mV)" />
        </LinearLayout>

        <TextView
            style="@style/PressureCalibrationSensorLabel"
            android:text="Toe outside" />

        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_toe_outside_c1"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient1" />
            <EditText
                android:id="@+id/input_toe_outside_c2"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient2" />
        </LinearLayout>
        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_toe_outside_c3"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient3" />
            <EditText
                android:id="@+id/input_toe_outside_threshold"
                style="@style/PressureCalibrationInput"
                android:hint="threshold (mV)" />
        </LinearLayout>

        <TextView
            style="@style/PressureCalibrationSensorLabel"
            android:text="Center" />

        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_center_c1"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient1" />
            <EditText
                android:id="@+id/input_center_c2"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient2" />
        </LinearLayout>
        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_center_c3"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient3" />
            <EditText
                android:id="@+id/input_center_threshold"
                style="@style/PressureCalibrationInput"
                android:hint="threshold (mV)" />
        </LinearLayout>

        <TextView
            style="@style/PressureCalibrationSensorLabel"
            android:text="Mid outside" />

        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_mid_outside_c1"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient1" />
            <EditText
                android:id="@+id/input_mid_outside_c2"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient2" />
        </LinearLayout>
        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_mid_outside_c3"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient3" />
            <EditText
                android:id="@+id/input_mid_outside_threshold"
                style="@style/PressureCalibrationInput"
                android:hint="threshold (mV)" />
        </LinearLayout>

        <TextView
            style="@style/PressureCalibrationSensorLabel"
            android:text="Heel" />

        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_heel_c1"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient1" />
            <EditText
                android:id="@+id/input_heel_c2"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient2" />
        </LinearLayout>
        <LinearLayout style="@style/PressureCalibrationInputRow">
            <EditText
                android:id="@+id/input_heel_c3"
                style="@style/PressureCalibrationInput"
                android:hint="coefficient3" />
            <EditText
                android:id="@+id/input_heel_threshold"
                style="@style/PressureCalibrationInput"
                android:hint="threshold (mV)" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
